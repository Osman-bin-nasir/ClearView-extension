# THIS IS THE EXTENSION'S .env — NOT THE BACKEND SERVER'S.
#
# The ClearView backend has its own .env, under `server/` in the ClearView
# repository, and it holds live secrets (a database URL, JWT_SECRET, an AWS key,
# password hashes). Do NOT copy it here. Only two keys are read from this file,
# and the generator ignores everything else — so the copy would do nothing except
# put secrets in the wrong repository, one `git add -f` away from being published
# with a browser extension.
#
# Copy this file to `.env`, fill it in, and run `npm run config`.
#
# NOTHING HERE IS READ AT RUNTIME. A Chrome extension has no environment, so
# `npm run config` bakes these values into `src/common/env.config.js`, which the
# extension imports. Editing `.env` without re-running that command changes
# nothing.
#
# None of these values is a secret. Do not put a password, a token or a service
# account here — the extension is not given one, and a credential shipped in an
# extension is a credential published to everyone who installs it.

# The administrator who moderates the shared blocklist.
#
# Used ONLY to pre-fill the sign-in form on the admin page. It grants nothing:
# the backend re-reads the account and its permissions on every request, so a
# value typed here (or changed here) cannot make anyone an administrator.
ADMIN_EMAIL=

# Point the extension at your own ClearView backend instead of the deployed one.
# Changing this at runtime is also possible from Full settings -> Backend server.
API_BASE=
