{
  "manifest_version": 3,
  "name": "ClearView — Content Protection",
  "version": "1.0.0",
  "description": "Blocks explicit sites and searches, YouTube ads, plus Shorts hiding and Brain Bot filtering.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "webNavigation",
    "declarativeNetRequest",
    "alarms",
    "contextMenus"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_ads",
        "enabled": false,
        "path": "src/background/rules/youtube-ads.json"
      }
    ]
  },
  "host_permissions": [
    "https://clearview-1neb.onrender.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "ClearView",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/youtube.js"],
      "css": ["src/content/youtube.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
